---
import Layout from "../layouts/Layout.astro";
import Card from "../components/Card.astro";
---

<Layout>
  <section style="padding: 4rem 2rem; max-width: 1200px; margin: 0 auto;">
    <h1 style="font-family: 'Bebas Neue', sans-serif; font-size: 3rem; color: var(--burgundy); margin-bottom: 0.5rem;">
      DEMO CARDS
    </h1>
    <p style="font-family: 'Poppins', sans-serif; color: var(--burgundy); margin-bottom: 3rem; opacity: 0.7;">
      Hacé click en cada card para ver el efecto de "llenado".
    </p>

    <div class="cards-grid">
      <Card
        color="var(--lilac, #C4B5FD)"
        title="SOBRE MÍ"
        subtitle="Conocé mi historia"
        description="De la manicuría al código: un camino poco convencional pero lleno de aprendizajes."
        tags={["Storytelling", "Identidad", "Pasión"]}
        href="#about"
      />

      <Card
        color="var(--pink-soft, #E8B4B8)"
        title="PROYECTOS"
        subtitle="Mi trabajo"
        description="Una selección de proyectos donde combiné diseño, código y atención al detalle."
        tags={["Web", "UI/UX", "Frontend"]}
        href="#projects"
      />

      <Card
        color="var(--jade, #7FB39B)"
        title="SKILLS"
        subtitle="Herramientas"
        description="Las tecnologías que uso día a día, desde el prototipo hasta el deploy."
        tags={["Astro", "React", "Tailwind", "Node"]}
        href="#skills"
      />

      <Card
        color="var(--gold, #D4A574)"
        title="SERVICIOS"
        subtitle="Lo que ofrezco"
        description="Diseño y desarrollo de sitios web con identidad propia, como un buen nail art."
        tags={["Diseño", "Desarrollo", "Mantenimiento"]}
        href="#services"
      />

      <Card
        color="var(--burgundy)"
        title="CONTACTO"
        subtitle="Hablemos"
        description="¿Tenés una idea? ¿Un proyecto? Escribime y lo hacemos realidad."
        tags={["Email", "LinkedIn", "GitHub"]}
        href="#contact"
      />
    </div>
  </section>

  <style>
    .cards-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 1.5rem;
    }

    
    :root {
      --lilac: #C4B5FD;
      --pink-soft: #E8B4B8;
      --jade: #7FB39B;
      --gold: #D4A574;
    }
  </style>
</Layout>