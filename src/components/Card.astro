---
interface Props {
  color?: string;
  title: string;
  subtitle?: string;
  description?: string;
  tags?: string[];
  href?: string;
  icon?: string;
  ctaLabel?: string; 
}

const {
  color = "var(--burgundy)",
  title,
  subtitle = "",
  description = "",
  tags = [],
  href = "#",
  icon = "",
  ctaLabel = "Ver más",
} = Astro.props;
---

<div
  class="card"
  data-card
  data-color={color}
  style={`--card-color: ${color};`}
>
  <div class="card__fill" aria-hidden="true"></div>

  <div class="card__content">
    <div class="card__header">
      {icon && <span class="card__icon">{icon}</span>}
      <h3 class="card__title">{title}</h3>
      {subtitle && <p class="card__subtitle">{subtitle}</p>}
    </div>

    <div class="card__body">
      {description && <p class="card__description">{description}</p>}

      {tags.length > 0 && (
        <ul class="card__tags">
          {tags.map((tag) => (
            <li class="card__tag">{tag}</li>
          ))}
        </ul>
      )}
    </div>

    <div class="card__footer">
      <a href={href} class="card__cta" data-cursor-label="Abrir">
        {ctaLabel}
        <span class="card__cta-arrow">→</span>
      </a>
    </div>
  </div>
</div>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 1.75rem;
    border: 2px solid var(--card-color);
    border-radius: 20px;
    background: transparent;
    color: var(--card-color);
    overflow: hidden;
    cursor: pointer;
    isolation: isolate;
    transition:
      transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 0.4s ease,
      color 0.35s ease,
      border-color 0.35s ease;
    will-change: transform;
  }

  /*hover: crece un poquito */
  .card:hover {
    transform: scale(1.03) translateY(-2px);
    box-shadow: 0 10px 30px -10px var(--card-color);
  }

  /*seleccionada: se llena de color, el texto en crema */
  .card.is-selected {
    transform: scale(1.05);
    color: var(--cream);
    border-color: var(--card-color);
    box-shadow: 0 18px 40px -12px var(--card-color);
  }

  /*fill efecto relleno de esmalte*/
  .card__fill {
    position: absolute;
    inset: 0;
    background: var(--card-color);
    border-radius: 18px;
    z-index: -1;
    transform: scale(0);
    transform-origin: center;
    transition: transform 0.6s cubic-bezier(0.65, 0, 0.35, 1);
    pointer-events: none;
  }

  .card.is-selected .card__fill {
    transform: scale(1);
  }

  .card__content {
    display: flex;
    flex-direction: column;
    height: 100%;
    gap: 1rem;
    position: relative;
    z-index: 1;
  }

  .card__header {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

.card__icon {
  font-size: 1.75rem;
  line-height: 1;
  display: inline-block;
  margin-bottom: 0.25rem;
  transform-origin: left center;
  transition: transform 0.3s ease;
}

.card:hover .card__icon {
  transform: scale(1.1) rotate(-5deg);
}


  .card__title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 2rem;
    font-weight: 400;
    letter-spacing: 0.03em;
    line-height: 1;
    margin: 0;
  }

  .card__subtitle {
    font-family: 'Poppins', sans-serif;
    font-size: 0.8rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    opacity: 0.75;
    margin: 0;
  }

  .card__body {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition:
      max-height 0.5s ease,
      opacity 0.4s ease 0.1s;
  }

  .card.is-selected .card__body {
    max-height: 400px;
    opacity: 1;
  }

  .card__description {
    font-family: 'Poppins', sans-serif;
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0;
  }

  .card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .card__tag {
    font-family: 'Poppins', sans-serif;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    border: 1.5px solid currentColor;
    opacity: 0.9;
  }

  /* footer cta */
  .card__footer {
    margin-top: auto;
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition:
      max-height 0.5s ease,
      opacity 0.4s ease 0.15s;
  }

  .card.is-selected .card__footer {
    max-height: 60px;
    opacity: 1;
  }

  .card__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: 'Poppins', sans-serif;
    font-size: 0.9rem;
    font-weight: 600;
    color: inherit;
    text-decoration: none;
    padding-top: 0.75rem;
    border-top: 1.5px solid currentColor;
    width: 100%;
    transition: gap 0.3s ease;
  }

  .card__cta:hover {
    gap: 0.9rem;
  }

  .card__cta-arrow {
    transition: transform 0.3s ease;
  }

  .card__cta:hover .card__cta-arrow {
    transform: translateX(4px);
  }
</style>